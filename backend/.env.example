# EcoX Backend Environment Variables
PROJECT_NAME="EcoX Backend"
API_V1_STR="/api/v1"
SECRET_KEY="temporary-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database (aiosqlite for local development; switchable to MySQL/Postgres in production)
DATABASE_URL="sqlite+aiosqlite:///./ecox.db"

# CORS configuration
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000"]

# File Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_MB=5
